# Kit: set DISCORD_BOT_TOKEN to run Discord-only. Empty optional values are safe.
# Copy to .env locally; use service variables on Railway. Never commit secrets.
DISCORD_BOT_TOKEN=
# Guild-scoped slash commands are bulk overwritten at startup when a guild is set.
# DISCORD_GUILD_ID falls back to DISCORD_ATTENDANCE_GUILD_ID when empty.
DISCORD_GUILD_ID=
# Optional: defaults to the logged-in bot's application/user ID.
DISCORD_APPLICATION_ID=
# Empty defaults to on with a guild ID. Set false to disable registration.
DISCORD_REGISTER_COMMANDS=
# Optional private staff operations channel: one mention-safe health line after
# Ready + command registration. Empty means no startup post. Also a permitted
# reminder destination, subject to live staff-only channel permission checks.
# Do not enable in production without separately approving the channel.
KIT_OPS_CHANNEL_ID=
# Optional staff ticket destination. Empty disables intake; only a guild text
# channel with verified staff-only View Channel overwrites is accepted.
# Administrators (including apps/bots) bypass overwrites: operator audience
# review is required. Ordinary operational feedback only, never safety reports
# or medical, family, or camper personal information.
# /ticket new requires DISCORD_ATTENDANCE_STAFF_IDS. No parent/camper intake.
# Message status survives restarts; open forms and rate limits do not.
# Separately approve the production channel and variable before enabling.
KIT_TICKETS_CHANNEL_ID=

# Slack is optional; supply BOTH tokens or leave both empty.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# HTTP health endpoints. Railway's PORT takes priority over HTTP_PORT.
# Leave PORT empty to use HTTP_PORT (default 8080).
PORT=
HTTP_PORT=8080

# AI is optional: commands and camp lookups work without an AI key.
# Select a currently available model from your provider's console.
# OpenAI-compatible providers are tried first (Groq, OpenAI, Ollama, etc.).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_NAME=
GEMINI_API_KEY=
GEMINI_MODEL=
CLAUDE_API_KEY=
CLAUDE_MODEL=

# Optional Camp Power-Up connection. Verify the deployed URL and protected
# /admin/export-json endpoint first; see docs/DEPLOYMENT.md.
# Leave this entire section empty to run Kit without camp data.
CAMP_API_BASE_URL=
CAMP_ADMIN_USERNAME=
CAMP_ADMIN_PASSWORD=
# Comma-separated Discord user IDs (find yours with !myid).
CAMP_ALLOWED_DISCORD_IDS=
# Optional exact role name, only in your trusted camp server.
CAMP_ALLOWED_ROLE=
# Comma-separated numeric IDs of the private staff channels where camp answers
# may be shown (threads inside them count). DMs always work. If empty, camp
# answers are limited to DMs. Copy a channel ID with Developer Mode enabled.
CAMP_ALLOWED_CHANNEL_IDS=
# Optional nonnegative capacity and polling interval (1-1440 minutes, default 5).
CAMP_CAPACITY=
CAMP_POLL_MINUTES=
# Optional alert channels: prefer unique numeric channel IDs over names.
CAMP_ALERTS_CHANNEL=
CAMP_STATUS_CHANNEL=
# Extra !links entries: Name|https://example.com, Another name|https://example.org
CAMP_EXTRA_LINKS=

# Private Discord attendance: OFF until a separately approved rollout.
# See docs/DISCORD_ATTENDANCE.md. Never reuse camp admin or provider credentials.
DISCORD_ATTENDANCE_ENABLED=
DISCORD_ATTENDANCE_API_BASE_URL=
DISCORD_ATTENDANCE_PARENT_TOKEN=
DISCORD_ATTENDANCE_STAFF_TOKEN=
DISCORD_ATTENDANCE_GUILD_ID=
# JSON array of approved staff Discord ID strings; also gates /kit status,
# /kit remind, /ticket and /camp (even when attendance is disabled).
# Reminders are in memory (lost on restart), staff text channels only,
# and must pass a live channel-privacy check at creation and delivery.
# /camp additionally requires CAMP_ALLOWED_DISCORD_IDS
# or CAMP_ALLOWED_ROLE, and an approved staff channel. Backend also enforces attendance.
DISCORD_ATTENDANCE_STAFF_IDS=
# Same session JSON as the backend, including exact label and configured ISO dates.
DISCORD_ATTENDANCE_SESSIONS=
